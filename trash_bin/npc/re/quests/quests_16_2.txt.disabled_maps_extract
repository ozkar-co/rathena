		cutin "ep16_crux_findel01.bmp",2;
		mes "[Crux]";
		mes "Ah, have you arrived?";
		mes "Have you come alone?";
		mes "I heard Skia was coming too ...";
		next;
		cloakoffnpcself( "Skia#ep162_03" );
