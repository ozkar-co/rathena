		cutin "ep16_crux_findel03.bmp",1;
		mes "[Crux]";
		mes "Oh, hello.";
		mes "Nice to meet you here.";
		mes "Me? I am just doing the task the Lady gave me.";
		sleep2 300;
		cutin "ep16_crux_findel02.bmp",1;
		close2;
		cutin "",255;
		npctalk "I have to finish quickly and go back ...", "", bc_self;
		end;
	}
